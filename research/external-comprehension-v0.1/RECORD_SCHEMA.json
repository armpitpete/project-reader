{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/armpitpete/project-reader/research/external-comprehension-v0.1/RECORD_SCHEMA.json",
  "title": "Project Reader External Comprehension Session Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kit_version",
    "participant_id",
    "record_status",
    "participant_context",
    "consent",
    "before_use",
    "observation",
    "after_use",
    "paid_outcome",
    "facilitator_notes",
    "participant_statements",
    "interpretation_after_session",
    "do_not_commit_completed_record"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kit_version": { "const": "external-comprehension-v0.1" },
    "participant_id": { "enum": ["R01", "R02", "R03", "R04", "R05"] },
    "record_status": { "enum": ["blank_template", "completed_off_git"] },
    "participant_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self_described_categories"],
      "properties": {
        "self_described_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "non_technical",
              "young_person",
              "neurodivergent",
              "overlapping_categories"
            ]
          }
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anonymous_notes_agreed",
        "may_stop_any_time_confirmed",
        "no_unnecessary_personal_data_confirmed"
      ],
      "properties": {
        "anonymous_notes_agreed": { "type": ["boolean", "null"] },
        "may_stop_any_time_confirmed": { "type": ["boolean", "null"] },
        "no_unnecessary_personal_data_confirmed": { "type": ["boolean", "null"] }
      }
    },
    "before_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_purpose",
        "github_comfort",
        "trust_or_distrust_factors"
      ],
      "properties": {
        "expected_purpose": { "type": ["string", "null"] },
        "github_comfort": { "type": ["string", "null"] },
        "trust_or_distrust_factors": { "type": ["string", "null"] }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_completed",
        "repository_used",
        "task_outcome",
        "help_requested",
        "first_screen_comprehension",
        "disclosure_controls_opened",
        "time_to_first_useful_answer_seconds",
        "hesitation_or_confusion_events",
        "misunderstandings"
      ],
      "properties": {
        "session_completed": { "type": ["boolean", "null"] },
        "repository_used": { "type": ["string", "null"] },
        "task_outcome": {
          "enum": ["successful", "partial", "not_successful", "stopped_by_participant", null]
        },
        "help_requested": {
          "enum": ["none", "clarification", "navigation_help", "technical_help", "facilitator_intervention", null]
        },
        "first_screen_comprehension": {
          "enum": ["clear", "partial", "confused", "not_observed", null]
        },
        "disclosure_controls_opened": {
          "type": "array",
          "items": { "type": "string" }
        },
        "time_to_first_useful_answer_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "hesitation_or_confusion_events": {
          "type": "array",
          "items": { "type": "string" }
        },
        "misunderstandings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "after_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_purpose",
        "completed_work",
        "remaining_or_uncertain_work",
        "evidence_recalled",
        "suggested_change",
        "trust_judgement",
        "stuck_or_unsure_moment"
      ],
      "properties": {
        "project_purpose": { "type": ["string", "null"] },
        "completed_work": { "type": ["string", "null"] },
        "remaining_or_uncertain_work": { "type": ["string", "null"] },
        "evidence_recalled": { "type": ["string", "null"] },
        "suggested_change": { "type": ["string", "null"] },
        "trust_judgement": { "type": ["string", "null"] },
        "stuck_or_unsure_moment": { "type": ["string", "null"] }
      }
    },
    "paid_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked_offer_id",
        "offer_made_after_example_and_description",
        "result",
        "participant_words",
        "public_repository_discussed",
        "facilitator_note"
      ],
      "properties": {
        "locked_offer_id": { "const": "owner-ready-report-25-gbp" },
        "offer_made_after_example_and_description": { "type": ["boolean", "null"] },
        "result": {
          "enum": ["paid", "explicit_commitment", "refused", "not_offered", null]
        },
        "participant_words": { "type": ["string", "null"] },
        "public_repository_discussed": { "type": ["string", "null"] },
        "facilitator_note": { "type": ["string", "null"] }
      }
    },
    "facilitator_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "participant_statements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "interpretation_after_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comprehension",
        "usability",
        "trust",
        "decision_signal"
      ],
      "properties": {
        "comprehension": { "enum": ["pass", "partial", "fail", null] },
        "usability": { "enum": ["pass", "partial", "fail", null] },
        "trust": { "enum": ["pass", "partial", "fail", null] },
        "decision_signal": { "enum": ["keep", "correct", "expand", "pause", "retire", null] }
      }
    },
    "do_not_commit_completed_record": { "const": true }
  }
}
